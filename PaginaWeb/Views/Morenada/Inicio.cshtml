@{
    ViewData["Title"] = "Inicio";
}


<section class="inicio">
    <!-- Hero con Imagen de Fondo -->
    <div class="hero d-flex align-items-center justify-content-center text-center position-relative">
        <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div>
        <div class="hero-content text-white position-relative z-1 px-3">
            <h1 class="display-3 fw-bold mb-3 animate__animated animate__fadeInDown">Bienvenidos a la Morenada Mejillones</h1>
            <p class="lead mb-4 animate__animated animate__fadeInUp">Rumbo a los 50 años de historia y tradición</p>
            <a href="#destacados" class="btn btn-warning btn-lg mt-4 animate__animated animate__pulse animate__delay-1s">
                Conoce Más <i class="bi bi-arrow-down-circle ms-2"></i>
            </a>
        </div>
    </div>

    <!-- Sección Destacados -->
    <div id="destacados" class="container py-5">
        <h2 class="text-center text-uppercase mb-5 display-4 text-primary">Lo Más Destacado</h2>
        <div class="row g-4">
            <!-- Tarjeta 1: Historia -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 overflow-hidden">
                    <img src="/images4/historia.jpg" alt="Historia del Conjunto" class="card-img-top img-fluid object-fit-cover" style="height: 250px;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary mb-3">Historia del Conjunto</h5>
                        <p class="card-text flex-grow-1">Descubre los orígenes y la rica tradición que hacen único a nuestro conjunto de Morenada.</p>
                        <a href="/Morenada/Historia" class="btn btn-outline-primary mt-auto align-self-start">
                            Leer Más <i class="bi bi-book ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2: Eventos -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 overflow-hidden">
                    <img src="/images4/Events.jpg" alt="Nuestros Eventos" class="card-img-top img-fluid object-fit-cover" style="height: 250px;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary mb-3">Nuestros Eventos</h5>
                        <p class="card-text flex-grow-1">Participa en los eventos que organizamos durante el año y forma parte de nuestra gran familia cultural.</p>
                        <a href="/Morenada/Eventos" class="btn btn-outline-primary mt-auto align-self-start">
                            Ver Más <i class="bi bi-calendar-event ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 3: Cancionero -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 overflow-hidden">
                    <img src="/images4/EleccionPredilecta2024.jpg" alt="Cancionero" class="card-img-top img-fluid object-fit-cover" style="height: 250px;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary mb-3">Cancionero</h5>
                        <p class="card-text flex-grow-1">Sumérgete en las canciones que inspiran nuestro baile y representan nuestra cultura.</p>
                        <a href="/Cancionero/Index" class="btn btn-outline-primary mt-auto align-self-start">
                            Explorar <i class="bi bi-music-note-list ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nueva Sección: Invitación y Video -->
    <div class="container py-5">
        <div class="row align-items-center">
            <!-- Imagen -->
            <div class="col-md-6 mb-4 mb-md-0">
                <img src="/images4/convocatoria_Cholas_antiguas.jpg" alt="Únete a Nuestros Bloques" class="img-fluid rounded shadow-lg">
            </div>

            <!-- Texto de Invitación -->
            <div class="col-md-6">
                <h2 class="text-primary mb-4">Únete a Nuestros Bloques</h2>
                <p class="lead text-muted mb-4">
                    ¿Te gustaría ser parte de nuestra gran familia? ¡Únete a uno de nuestros bloques y vive la experiencia de bailar en la Morenada Mejillones! Tenemos espacios para todas las edades y niveles de experiencia.
                </p>
                <a href="#unete" class="btn btn-primary btn-lg">
                    ¡Inscríbete Ahora! <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Video de YouTube -->
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="ratio ratio-16x9">
                    <iframe src="https://www.youtube.com/embed/g4R-dBAb1eY?autoplay=1&loop=1"
                            title="YouTube Video - Morenada Mejillones"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            class="rounded shadow-lg"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>