<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galería de Imágenes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="gallery.css">
</head>
<body>
    <section class="gallery py-5">
        <div class="container">
            <h2 class="text-center text-uppercase mb-4 display-4 text-primary">Nuestra Historia en Imágenes</h2>
            <p class="text-center lead mb-5">Un viaje visual a través de los años</p>

            <div class="gallery-grid">
                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/Images/vertical1.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay"> Predilecta 2025</div>
                    </div>
                </div>
                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/images/vertical2.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay">Convite</div>
                    </div>
                </div>
                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/images/predilecta2.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay">Descripción de la imagen 3</div>
                    </div>
                </div>

                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/images/BAILARINAS MEJILLONES 2.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay">Descripción de la imagen 3</div>
                    </div>
                </div>

                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/images/BAILARINAS MEJILLONES 3.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay">Descripción de la imagen 3</div>
                    </div>
                </div>

                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/images/BAILARINAS MEJILLONES 4.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay">Descripción de la imagen 3</div>
                    </div>
                </div>
                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/images/BAILARINAS MEJILLONES 5.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay">Descripción de la imagen 3</div>
                    </div>
                </div>
                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/images/BAILARINAS MEJILLONES 6.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay">Descripción de la imagen 3</div>
                    </div>
                </div>
                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/images/BAILARINAS MEJILLONES 7.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay">Descripción de la imagen 3</div>
                    </div>
                </div>
                <div class="gallery-item">
                    <div class="image-wrapper">
                        <img src="/images/BAILARINAS MEJILLONES 8.jpg" alt="Descripción de la imagen" class="gallery-image">
                        <div class="image-overlay">Descripción de la imagen 3</div>
                    </div>
                </div>

            </div>
            </div>
        </div>
    </section>

    <!-- Lightbox Modal -->
    <div class="modal fade" id="galleryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Galería Histórica</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="lightbox-image-container">
                        <img src="" alt="Imagen ampliada" class="img-fluid lightbox-image">
                        <div class="lightbox-info">
                            <span class="lightbox-year"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary me-2" id="prevImage">Anterior</button>
                    <button class="btn btn-outline-secondary" id="nextImage">Siguiente</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="gallery.js"></script>
</body>
</html>