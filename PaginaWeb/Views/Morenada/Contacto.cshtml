<div class="container my-5">
    <h2 class="text-center mb-4">Contáctanos</h2>
    <p class="text-center mb-5">Si tienes alguna consulta o deseas comunicarte con nosotros, no dudes en escribirnos.</p>

    <!-- Mapa de Google -->
    <div class="map-container mb-5 rounded overflow-hidden shadow">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d237.20851093201014!2d-67.10952805070342!3d-17.96308997550724!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x93e2b1f29eec50e1%3A0xe77c694662563f07!2sSindicato%20de%20transporte%20pesado%20internacional%20Mejillones!5e0!3m2!1ses!2sbo!4v1730857714650!5m2!1ses!2sbo"
            width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

    <!-- Horario de Atención -->
    <div class="business-hours text-center mb-5">
        <p><strong>Horario de Atención:</strong> Lunes a Viernes de 8:00 a 12:00 y de 14:00 a 18:00</p>
    </div>

    <!-- Formulario de Contacto -->
    <div class="row align-items-center">
        <!-- Formulario -->
        <div class="col-md-6 mb-4">
            <h4 class="mb-4">Envíanos un Mensaje</h4>
            <form>
                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre:</label>
                    <input type="text" class="form-control" id="nombre" placeholder="Tu nombre" required>
                </div>
                <div class="mb-3">
                    <label for="asunto" class="form-label">Asunto:</label>
                    <input type="text" class="form-control" id="asunto" placeholder="Asunto del mensaje" required>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Correo Electrónico:</label>
                    <input type="email" class="form-control" id="email" placeholder="Tu correo electrónico" required>
                </div>
                <div class="mb-3">
                    <label for="mensaje" class="form-label">Mensaje:</label>
                    <textarea class="form-control" id="mensaje" rows="5" placeholder="Escribe tu mensaje aquí" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100">Enviar</button>
            </form>
        </div>

        <!-- Imagen Decorativa -->
        <div class="col-md-6 text-center">
            <img src="~/images/Contacto.jpg" alt="Contacto" class="img-fluid rounded shadow" style="max-height: 400px; object-fit: cover;">
        </div>
    </div>

