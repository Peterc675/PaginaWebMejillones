@model List<dynamic>

<section class="cancionero py-5">
    <div class="container">
        <h1 class="text-uppercase text-center mb-5">Cancionero</h1>

        <!-- Tarjetas de canciones -->
        <div class="row">
            @foreach (var cancion in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow h-100 border-0">
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title text-primary text-center">@cancion.Titulo</h4>
                            <p class="card-text text-center text-secondary">@cancion.Autor</p>
                            <div class="mt-auto text-center">
                                <a asp-controller="Cancionero" asp-action="Detalle" asp-route-id="@cancion.Id" class="btn btn-outline-primary">
                                    Ver Detalles
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
